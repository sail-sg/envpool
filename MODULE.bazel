    "mujoco",
    "mujoco_dmc_xml",
    "mujoco_gym_xml",
    "mujoco_menagerie_playground",
    "mujoco_playground_source",
    "myosuite_furniture_sim",
    "myosuite_mpl_sim",
    "myosuite_myo_sim",
    "myosuite_object_sim",
    "myosuite_source",
