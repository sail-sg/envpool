module(name = "envpool")

bazel_dep(name = "bazel_features", version = "1.51.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bzip2", version = "1.0.8.bcr.4")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "36.0", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_boost", repo_name = "com_github_nelhage_rules_boost")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "xz", version = "5.4.5.bcr.8")
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")

archive_override(
    module_name = "rules_boost",
    patches = [
        "//third_party/boost:filesystem_scope_headers.patch",
        "//third_party/boost:unused_dependencies.patch",
        "//third_party/boost:windows_common_defines.patch",
    ],
    sha256 = "4f3e5a8091c4d2d369176e23a744a6bb1ee6f5b42beb1af192a6311cc3402ace",
    strip_prefix = "rules_boost-d4d306ef48b7dbddf0389e48b90f6eb74ec18a71",
    type = "tar.gz",
    urls = [
        "https://codeload.github.com/nelhage/rules_boost/tar.gz/d4d306ef48b7dbddf0389e48b90f6eb74ec18a71",
    ],
)

single_version_override(
    module_name = "rules_foreign_cc",
    patches = ["//third_party/rules_foreign_cc:bazel9_windows_cc_import.patch"],
)

register_toolchains("//third_party/rules_foreign_cc:linux_arm64_preinstalled_ninja")

single_version_override(
    module_name = "rules_python",
    patches = [
        "//third_party/rules_python:pip_repository_host_platform.patch",
        "//third_party/rules_python:windows_short_wheel_names.patch",
        "//third_party/rules_python:zipapp_explicit_init.patch",
    ],
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.12",
)
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.13",
)
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.14",
)
use_repo(python, "python_3_12", "python_3_13", "python_3_14", "python_versions")

# Short internal hub names keep Windows DLL runfile paths below MAX_PATH.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.override(
    file = "jumanji-1.1.2-py3-none-any.whl",
    patch_strip = 1,
    patches = ["//third_party/jumanji:matplotlib_311_autoscale.patch"],
)
pip.parse(
    hub_name = "p",
    python_version = "3.12",
    requirements_lock = "//third_party/pip_requirements:requirements.txt",
)
pip.parse(
    hub_name = "p",
    python_version = "3.13",
    requirements_lock = "//third_party/pip_requirements:requirements.txt",
)
pip.parse(
    hub_name = "p",
    python_version = "3.14",
    requirements_lock = "//third_party/pip_requirements:requirements.txt",
)
pip.parse(
    hub_name = "j",
    python_version = "3.12",
    requirements_lock = "//third_party/jumanji:oracle_requirements.txt",
)
pip.parse(
    hub_name = "m",
    python_version = "3.12",
    requirements_lock = "//third_party/myosuite:oracle_requirements.txt",
)
use_repo(
    pip,
    jumanji_oracle_requirements = "j",
    myosuite_oracle_requirements = "m",
    pip_requirements = "p",
)

envpool_repositories = use_extension("//envpool:workspace0.bzl", "repositories")
use_repo(
